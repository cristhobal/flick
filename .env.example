# Fuente de datos: usa "tmdb" para TMDB o "local" para archivos locales.
DATA_SOURCE=tmdb
PUBLIC_DATA_SOURCE=tmdb

# TMDB Read Access Token v4. Debe empezar normalmente con "eyJ".
# No uses la API Key v3 corta aqui.
PUBLIC_TMDB_TOKEN=REEMPLAZA_CON_TU_TMDB_READ_ACCESS_TOKEN_V4

# Carpeta de la biblioteca local (solo para DATA_SOURCE=local). Si la dejas vacia,
# Flick busca una carpeta "Peliculas" sola: cualquier unidad en Windows (D:\Peliculas),
# los puntos de montaje en Linux/macOS (/run/media, /media, /mnt, /srv, /Volumes) y las
# carpetas habituales del home (~/Peliculas, ~/Videos/Peliculas, ~/Movies/Peliculas).
#
# Si usas el mismo repo en Windows y en Linux, separa varias rutas con "|" y se usara
# la primera que exista en la maquina actual:
# LOCAL_MOVIES_DIR=D:\Peliculas|/mnt/media/Peliculas
#
# O ponlas en variables distintas; estas tienen prioridad en su propio sistema:
# LOCAL_MOVIES_DIR_WINDOWS=D:\Peliculas
# LOCAL_MOVIES_DIR_LINUX=/mnt/media/Peliculas
# LOCAL_MOVIES_DIR_MAC=/Volumes/Media/Peliculas
